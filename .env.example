# Configuration du serveur AMDA BTP.
# Copiez ce fichier en « .env » puis complétez-le. Le fichier .env ne doit jamais être partagé.

# --- Serveur ---------------------------------------------------------------
PORT=4321
# Adresse publique du site, utilisée dans les liens des emails.
SITE_URL=http://localhost:4321

# --- Back-office -----------------------------------------------------------
# Générez les deux valeurs ci-dessous avec :  npm run motdepasse -- "VotreMotDePasse"
ADMIN_USER=amda
ADMIN_PASSWORD_HASH=
SESSION_SECRET=
SESSION_HOURS=12

# --- Notifications par email (SMTP Gmail) ----------------------------------
# Laissez SMTP_HOST vide pour désactiver les emails : les demandes restent enregistrées.
# SMTP_PASS est un « mot de passe d'application » de 16 caractères créé sur
# https://myaccount.google.com/apppasswords — jamais le mot de passe du compte Google.
# La validation en deux étapes doit être active sur le compte.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=adresse@gmail.com
SMTP_PASS=
# Gmail impose l'adresse du compte comme expéditeur : reprenez celle de SMTP_USER.
MAIL_FROM=AMDA BTP <adresse@gmail.com>
# Adresse de l'équipe AMDA qui reçoit les demandes.
MAIL_TO=

# --- Notifications WhatsApp (Meta Cloud API) -------------------------------
# Nécessite un compte WhatsApp Business validé par Meta.
# Laissez vide pour désactiver : le back-office propose de toute façon un lien
# « Répondre sur WhatsApp » qui ouvre la conversation avec le client.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
# Numéro de l'agent AMDA prévenu, au format international sans « + ». Ex. 22901000000
WHATSAPP_TO=
# Hors de la fenêtre de 24 h, Meta exige un modèle validé. Laissez vide pour un message simple.
WHATSAPP_TEMPLATE=
WHATSAPP_TEMPLATE_LANG=fr

# --- Limites ---------------------------------------------------------------
MAX_BODY_MB=25
MAX_FILE_MB=8
MAX_FILES=6
RATE_LIMIT=8
RATE_WINDOW_MIN=10
